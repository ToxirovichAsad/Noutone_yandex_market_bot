# Copy to .env and fill in real values. Never commit .env itself.

# Yandex Market Partner API (get from partner.market.yandex.ru dashboard,
# API settings - Asadbek's own account owns this)
YANDEX_MARKET_API_KEY=ACMA:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx:xxxxxxxx
YANDEX_MARKET_BUSINESS_ID=
YANDEX_MARKET_CAMPAIGN_ID=
YANDEX_MARKET_WAREHOUSE_ID=

# Noutone inserter (source of laptop data) - same key as the other products,
# see notuone_big/.env or the other Noutone_* products' .env files
INSERTER_API_URL=https://noutone-inserter.vercel.app
INSERTER_API_KEY=

# Telegram - same bot/staff group Noutone_miniapp and Noutone_web_miniapp use
# for consult/lead notifications (see Noutone_miniapp/.env for real values)
TELEGRAM_BOT_TOKEN=
TELEGRAM_STAFF_CHAT_ID=
